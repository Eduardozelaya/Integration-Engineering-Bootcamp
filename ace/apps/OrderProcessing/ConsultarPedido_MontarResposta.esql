

CREATE COMPUTE MODULE ConsultarPedido_MontarResposta
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		    -- O MQReply precisa do MQMD da requisicao: e dele que vem o ReplyToQ
		    SET OutputRoot.Properties = InputRoot.Properties;
		    SET OutputRoot.MQMD       = InputRoot.MQMD;
		    
		    -- Resposta de consulta so vale enquanto alguem espera: 300 decimos de segundo = 30 s.
		    -- Sem isto, a resposta a um requisitante que desistiu fica orfa para sempre (exp R1).
		    SET OutputRoot.MQMD.Expiry = 300;
		    
		        -- Gatilho do R3: falha proposital no servico de consulta
		    IF COALESCE(InputRoot.JSON.Data.forcarErro, '') = 'true' THEN
		      THROW USER EXCEPTION SEVERITY 3 CATALOG 'BIPmsgs' MESSAGE 2951
		            VALUES('Falha proposital no ConsultarPedido');
		    END IF;
		
		    SET OutputRoot.JSON.Data.orderId      = InputRoot.JSON.Data.orderId;
		    SET OutputRoot.JSON.Data.status       = 'RECEBIDO';
		    SET OutputRoot.JSON.Data.respondidoEm =
		        CAST(CURRENT_GMTTIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSSZZZ');
		    RETURN TRUE;
	END;
END MODULE;
