CREATE COMPUTE MODULE ConsultarPedido_MontarErro
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		        -- 1. Extrai o erro mais interno do ExceptionList
    DECLARE ex REFERENCE TO InputExceptionList.*[1];
    DECLARE codigo  INTEGER;
    DECLARE texto   CHARACTER;
    DECLARE detalhe CHARACTER;
    WHILE LASTMOVE(ex) DO
      IF ex.Number IS NOT NULL THEN
        SET codigo = ex.Number;
        SET texto  = ex.Text;
        IF EXISTS(ex.Insert[]) THEN
          SET detalhe = ex.Insert[<].Text;
        END IF;
      END IF;
      MOVE ex LASTCHILD;
    END WHILE;
    DECLARE agora CHARACTER
        CAST(CURRENT_GMTTIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSSZZZ');

    -- 2. GUARDA: original + motivo na fila de auditoria (out1 -> GuardarErro)
    SET OutputRoot.Properties  = InputRoot.Properties;
    SET OutputRoot.MQMD        = InputRoot.MQMD;
    SET OutputRoot.MQMD.MsgType = 8;     -- datagrama: e registro, nao requisicao
    SET OutputRoot.MQMD.Expiry  = -1;    -- auditoria nao expira
    SET OutputRoot.JSON.Data.original       = InputRoot.JSON.Data;
    SET OutputRoot.JSON.Data.erro.codigo    = codigo;
    SET OutputRoot.JSON.Data.erro.mensagem  = texto;
    SET OutputRoot.JSON.Data.erro.detalhe   = detalhe;
    SET OutputRoot.JSON.Data.erro.flow      = 'ConsultarPedido';
    SET OutputRoot.JSON.Data.erro.falhouEm  = agora;
    SET OutputRoot.JSON.Data.erro.msgIdRequisicao = CAST(InputRoot.MQMD.MsgId AS CHARACTER);
    PROPAGATE TO TERMINAL 'out1';

    -- 3. RESPONDE: erro ao requisitante (out -> ResponderErro)
    SET OutputRoot.Properties  = InputRoot.Properties;
    SET OutputRoot.MQMD        = InputRoot.MQMD;
    SET OutputRoot.MQMD.Expiry = 300;
    SET OutputRoot.JSON.Data.orderId          = InputRoot.JSON.Data.orderId;
    SET OutputRoot.JSON.Data.status           = 'ERRO';
    SET OutputRoot.JSON.Data.motivo.codigo    = codigo;
    SET OutputRoot.JSON.Data.motivo.mensagem  = texto;
    SET OutputRoot.JSON.Data.motivo.detalhe   = detalhe;
    SET OutputRoot.JSON.Data.respondidoEm     = agora;
    RETURN TRUE;
	END;
END MODULE;
